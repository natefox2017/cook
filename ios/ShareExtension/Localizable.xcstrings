    "The source app did not provide a readable link or text.": {
      "comment": "Share Extension user-facing status or error.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源 App 没有提供可读取的链接或文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源 App 未提供可讀取的連結或文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有元アプリから読み取り可能なリンクやテキストを取得できませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quell-App hat keinen lesbaren Link oder Text bereitgestellt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app source n’a fourni aucun lien ou texte lisible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de origen no proporcionó ningún enlace o texto legible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app di origine non ha fornito un link o un testo leggibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação de origem não forneceu uma ligação nem texto legível."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bronapp leverde geen leesbare link of tekst aan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 앱에서 읽을 수 있는 링크나 텍스트를 제공하지 않았습니다."
          }
        }
      }
    },
    "Share a public recipe link, readable text, image, or PDF.": {
      "comment": "Share Extension user-facing status or error.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请分享公开食谱链接、文字、图片或 PDF。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請分享公開食譜連結、文字、圖片或 PDF。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開レシピのリンク、テキスト、画像、PDF を共有してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile einen öffentlichen Rezeptlink, lesbaren Text, ein Bild oder ein PDF."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez un lien public de recette, du texte lisible, une image ou un PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte un enlace público de receta, texto legible, una imagen o un PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi un link pubblico a una ricetta, testo leggibile, un’immagine o un PDF."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Partilhe uma ligação pública para uma receita, texto legível, uma imagem ou um PDF."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel een openbare receptlink, leesbare tekst, een afbeelding of een pdf."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 레시피 링크, 읽을 수 있는 텍스트, 이미지 또는 PDF를 공유하세요."
          }
        }
      }
    },
    "This attachment type is not supported.": {
      "comment": "Share Extension user-facing status or error.",
