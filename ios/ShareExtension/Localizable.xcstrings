    "Recipe Pals’ shared storage is not available. Check App Group signing.": {
      "comment": "Shared storage errors resolved from RecipeCore.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私人菜谱无法访问共享存储，请检查 App Group 签名配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私人菜譜無法存取共享儲存空間，請檢查 App Group 簽署設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Pals の共有ストレージにアクセスできません。App Group の署名設定を確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gemeinsame Speicher von Recipe Pals ist nicht verfügbar. Überprüfe die App-Group-Signierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage partagé de Recipe Pals est indisponible. Vérifiez la configuration de signature App Group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento compartido de Recipe Pals no está disponible. Comprueba la configuración de firma de App Group."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di archiviazione condiviso di Recipe Pals non è disponibile. Controlla la configurazione della firma di App Group."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Pals의 공유 저장소를 사용할 수 없습니다. App Group 서명 설정을 확인하세요."
          }
        }
      }
    },
    "Share a public HTTPS link, readable text, image, or PDF to Recipe Pals.": {
      "comment": "Shared storage errors resolved from RecipeCore.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请向私人菜谱分享公开的 HTTPS 链接、可读取文本、图片或 PDF。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請向私人菜譜分享公開的 HTTPS 連結、可讀取文字、圖片或 PDF。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開 HTTPS リンク、読み取り可能なテキスト、画像、PDF を Recipe Pals に共有してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile einen öffentlichen HTTPS-Link, lesbaren Text, ein Bild oder ein PDF mit Recipe Pals."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez avec Recipe Pals un lien HTTPS public, du texte lisible, une image ou un PDF."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte con Recipe Pals un enlace HTTPS público, texto legible, una imagen o un PDF."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi con Recipe Pals un link HTTPS pubblico, testo leggibile, un’immagine o un PDF."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 HTTPS 링크, 읽을 수 있는 텍스트, 이미지 또는 PDF를 Recipe Pals에 공유하세요."
          }
        }
      }
    },
    "The original shared source is missing. Share it again.": {
      "comment": "Shared storage errors resolved from RecipeCore.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始分享内容已丢失，请重新分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始分享內容已遺失，請重新分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有元のコンテンツが見つかりません。もう一度共有してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprünglich geteilte Quelle fehlt. Teile sie erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source partagée d’origine est introuvable. Partagez-la à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la fuente compartida original. Compártela de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
