            "state": "translated",
            "value": "이 첨부 파일 형식은 지원되지 않습니다."
          }
        }
      }
    },
    "The shared item could not be read. Try copying the link or text.": {
      "comment": "Share Extension user-facing status or error.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取分享内容，请复制链接或文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取分享內容，請複製連結或文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された内容を読み取れません。リンクかテキストをコピーしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geteilte Element konnte nicht gelesen werden. Kopiere stattdessen den Link oder Text."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l’élément partagé. Essayez de copier le lien ou le texte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el elemento compartido. Prueba a copiar el enlace o el texto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l’elemento condiviso. Prova a copiare il link o il testo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o item partilhado. Experimente copiar a ligação ou o texto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan het gedeelde item niet lezen. Probeer de link of tekst te kopiëren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 항목을 읽을 수 없습니다. 링크나 텍스트를 복사해 보세요."
          }
        }
      }
    },
