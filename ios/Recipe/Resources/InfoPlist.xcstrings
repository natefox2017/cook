    "NSCameraUsageDescription": {
      "comment": "App camera permission explanation when photographing a recipe",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a recipe to read its text and save it to your recipe library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピを撮影して文字を読み取り、レシピライブラリに保存するためにカメラを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄食谱照片，识别其中的文字并保存到您的食谱库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拍攝食譜照片，辨識其中的文字並儲存到您的食譜庫。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere ein Rezept, um den Text zu lesen und es in deiner Rezeptsammlung zu speichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez une recette pour lire son texte et l’enregistrer dans votre bibliothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía una receta para leer su texto y guardarla en tu biblioteca de recetas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografa una ricetta per leggerne il testo e salvarla nella tua raccolta di ricette."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe uma receita para ler o texto e guardá-la na sua biblioteca de receitas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografeer een recept om de tekst te lezen en het op te slaan in je receptenbibliotheek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피를 촬영하여 텍스트를 읽고 레시피 보관함에 저장합니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Explicit opt-in, foreground-only on-device cooking voice commands",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow voice commands in Cooking Mode after you turn on hands-free control. Audio is processed on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンズフリー操作をオンにした場合のみ、調理画面で音声コマンドを認識するためにマイクを使用します。音声は端末内で処理します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在您开启免手操作后，烹饪模式才使用麦克风识别语音指令。音频仅在设备本地处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在您開啟免手操作後，烹飪模式才使用麥克風辨識語音指令。音訊僅在裝置本機處理。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon wird nur für Sprachbefehle im Kochmodus verwendet, wenn die Freisprechsteuerung aktiviert ist. Audio wird ausschließlich auf diesem Gerät verarbeitet."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Explicit opt-in, foreground-only on-device cooking voice commands",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognize optional Next, Previous, and Repeat commands while Cooking Mode is open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調理モードを開いている間、任意で「次へ」「前へ」「繰り返し」などの音声操作を認識します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在烹饪模式开启期间，根据您的选择识别“下一步”“上一步”“重复”等语音指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在烹飪模式開啟期間，依您的選擇辨識「下一步」「上一步」「重複」等語音指令。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Sprachbefehle wie „Weiter“, „Zurück“ und „Wiederholen“ erkennen, während der Kochmodus geöffnet ist."
          }
        }
      }
    }
  },
  "version": "1.0"
}
