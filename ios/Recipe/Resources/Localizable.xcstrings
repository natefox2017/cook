    "Read and edit saved recipes, cook, and use a local shopping list.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したレシピの閲覧・編集、調理、端末内の買い物リストをご利用いただけます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可查看和编辑已保存的菜谱、开始烹饪，并使用本地购物清单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可查看和編輯已儲存的食譜、開始烹飪，並使用本機購物清單。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies und bearbeite gespeicherte Rezepte, koche und nutze eine lokale Einkaufsliste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez et modifiez vos recettes enregistrées, cuisinez et utilisez une liste de courses locale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee y edita recetas guardadas, cocina y usa una lista de compras local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi e modifica le ricette salvate, cucina e usa una lista della spesa locale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia e edite receitas salvas, cozinhe e use uma lista de compras local."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees en bewerk opgeslagen recepten, kook en gebruik een lokale boodschappenlijst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 레시피를 읽고 편집하며 요리하고 로컬 장보기 목록을 사용하세요."
          }
        }
      }
    },
