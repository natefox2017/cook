        }
      }
    },
    "Amounts can be numbers, ranges or words such as “to taste”. Keep the amount that works for your shop.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分量は数値・範囲・「適量」などで入力できます。買い物に必要な表記を残してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用量可填写数字、范围或“适量”等文字，请保留实际需要购买的用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用量可以是數字、範圍或「適量」等文字，請保留實際需要購買的用量。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengen können Zahlen, Bereiche oder Angaben wie „nach Geschmack“ sein. Behalte die Menge bei, die für deinen Einkauf passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quantités peuvent être des nombres, des plages ou des indications comme « selon le goût ». Gardez la quantité adaptée à vos courses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cantidades pueden ser números, intervalos o expresiones como «al gusto». Mantén la cantidad que te sirva para comprar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quantità possono essere numeri, intervalli o espressioni come «quanto basta». Mantieni la quantità più utile per la tua spesa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As quantidades podem ser números, intervalos ou palavras como “a gosto”. Mantenha a quantidade adequada para suas compras."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoeveelheden kunnen getallen, bereiken of woorden zoals ‘naar smaak’ zijn. Behoud de hoeveelheid die past bij je boodschappen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분량은 숫자, 범위 또는 ‘기호에 맞게’ 같은 표현으로 입력할 수 있습니다. 장보기에 필요한 분량을 그대로 유지하세요."
          }
        }
      }
    },
