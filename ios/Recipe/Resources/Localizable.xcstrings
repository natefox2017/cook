            "value": "添加午餐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增午餐"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昼食を追加"
          }
        }
      }
    },
    "Add dinner": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加晚餐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增晚餐"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕食を追加"
          }
        }
      }
    },
    "Change breakfast": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换早餐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換早餐"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝食を変更"
          }
        }
      }
    },
    "Change lunch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换午餐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換午餐"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昼食を変更"
          }
        }
      }
    },
    "Change dinner": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更换晚餐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更換晚餐"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕食を変更"
          }
        }
      }
    },
    "From a recipe or social app, use Share and choose RecipePouch. The share extension receives it quickly so you can return to the source app. If sharing is unavailable, use Add Recipe to paste a link, add text or an image, or create a recipe manually.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在食谱或社交 App 中打开系统分享并选择 RecipePouch。分享扩展会快速接收内容，让你返回来源 App。如果无法分享，可使用“添加食谱”粘贴链接、添加文本或图片，或手动创建食谱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在食譜或社群 App 中開啟系統分享並選擇 RecipePouch。分享延伸功能會快速接收內容，讓你返回來源 App。如果無法分享，可使用「新增食譜」貼上連結、新增文字或照片，或手動建立食譜。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピやSNSアプリの共有メニューからRecipePouchを選びます。共有機能がすぐに受け取るので、元のアプリに戻れます。共有できない場合は「レシピを追加」からリンク、テキスト、画像を追加するか、手動で作成してください。"
          }
        }
      }
    },
    "Use Add to Groceries in a recipe, choose the servings and ingredients, then add them to your list. In Groceries, tap a circle to mark an item bought, tap its name to edit, or swipe for more actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在食谱中选择“加入购物清单”，再选择份数和食材并添加到清单。在“购物清单”中，点圆圈可标记为已购买，点名称可编辑，也可轻扫查看更多操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在食譜中選擇「加入購物清單」，再選擇份數和食材並新增至清單。在「購物清單」中，點選圓圈可標記為已購買，點選名稱可編輯，也可輕掃查看更多操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピで「買い物リストに追加」を選び、人数と材料を選んでリストに追加します。Groceriesでは、丸印をタップして購入済みにし、名前をタップして編集するか、スワイプしてその他の操作を表示します。"
          }
        }
      }
    },
    "RecipePouch account and cloud data deleted. Local data on this iPhone was kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RecipePouch 账号和云端数据已删除。这部 iPhone 上的本机数据已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RecipePouch 帳號和雲端資料已刪除。這部 iPhone 上的本機資料已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RecipePouchアカウントとクラウドデータを削除しました。このiPhoneのローカルデータは保持されています。"
          }
        }
      }
    },
    "This deletes the signed-in RecipePouch account and cloud data. Local data on this iPhone stays until you delete it separately. This does not cancel an App Store subscription.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除已登录的 RecipePouch 账号和云端数据。此 iPhone 上的本机数据会保留，直到你单独删除。此操作不会取消 App Store 订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除已登入的 RecipePouch 帳號和雲端資料。此 iPhone 上的本機資料會保留，直到你另外刪除。此操作不會取消 App Store 訂閱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン中のRecipePouchアカウントとクラウドデータを削除します。このiPhoneのローカルデータは別途削除するまで残ります。App Storeのサブスクリプションは解約されません。"
          }
        }
      }
    },
    "Export failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出失败：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出失敗：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートに失敗しました：%@"
          }
        }
      }
    },
    "RecipePouch is designed as a private recipe utility. It does not publish your recipes to a public feed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RecipePouch 是一款私人的食谱管理工具，不会将你的食谱发布到公开动态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "RecipePouch 是一款私人的食譜管理工具，不會將你的食譜發布到公開動態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RecipePouchはプライベートなレシピ管理ツールとして設計されており、レシピを公開フィードに投稿しません。"
          }
        }
      }
    },
    "Automated imports may send source material to RecipePouch’s backend only when processing is required. Provider secrets remain server-side.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在需要处理时，自动导入才会将来源内容发送到 RecipePouch 后端。服务提供方密钥仅保留在服务器端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在需要處理時，自動匯入才會將來源內容傳送至 RecipePouch 後端。服務提供方金鑰僅保留在伺服器端。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動取り込みでは、処理が必要な場合に限りソース情報をRecipePouchのバックエンドに送信します。プロバイダーの秘密情報はサーバー側に保管されます。"
          }
        }
      }
    },
    "App Store purchases are managed by Apple. Your App Store purchase identity and RecipePouch account are treated as separate identities.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 购买项目由 Apple 管理。App Store 购买身份与 RecipePouch 账号彼此独立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 購買項目由 Apple 管理。App Store 購買身分與 RecipePouch 帳號彼此獨立。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeの購入はAppleが管理します。App Storeの購入に使うアカウントとRecipePouchアカウントは別々に扱われます。"
          }
        }
      }
    },
    "You can export local data and request deletion of your RecipePouch account data from Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在“设置”中导出本机数据，并申请删除 RecipePouch 账号数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在「設定」中匯出本機資料，並申請刪除 RecipePouch 帳號資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Settingsからローカルデータをエクスポートし、RecipePouchアカウントデータの削除を申請できます。"
          }
        }
      }
    },
    "Choose how to connect this iPhone’s local library to your RecipePouch account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择如何将这部 iPhone 上的本机食谱库连接到 RecipePouch 账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇如何將這部 iPhone 上的本機食譜庫連結至 RecipePouch 帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneのローカルライブラリをRecipePouchアカウントに接続する方法を選んでください。"
          }
        }
      }
    },
    "Both this iPhone and the cloud changed the same data. Choose which version to keep for each conflict.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 和云端都更改了同一项数据。请为每个冲突选择要保留的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 iPhone 和雲端都變更了同一項資料。請為每個衝突選擇要保留的版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneとクラウドで同じデータが変更されました。競合ごとに残すバージョンを選択してください。"
          }
        }
      }
    },
    "Your library could not be read. Its original file has been preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取食谱库。原始文件已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取食譜庫。原始檔案已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリを読み込めませんでした。元のファイルは保持されています。"
          }
        }
      }
    },
    "This recipe is no longer in your library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此食谱已不在你的食谱库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此食譜已不在你的食譜庫中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレシピはライブラリにありません。"
          }
        }
      }
    },
    "This item is no longer available. Please reopen the recipe or list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目已不可用。请重新打开食谱或清单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目已無法使用。請重新開啟食譜或清單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目は利用できません。レシピまたはリストを開き直してください。"
          }
        }
      }
    },
    "This library was saved in an unsupported format. Its original file has been preserved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此食谱库以不受支持的格式保存。原始文件已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此食譜庫以不支援的格式儲存。原始檔案已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリは未対応の形式で保存されています。元のファイルは保持されています。"
          }
        }
      }
    },
    "Ingredient amounts must be finite numbers of zero or more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食材用量必须是大于或等于零的有限数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食材用量必須是大於或等於零的有限數值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料の量は0以上の有限数で入力してください。"
          }
        }
      }
    },
    "Choose a positive, finite serving multiplier.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "份数倍率必须是有限的正数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "份數倍率必須是有限的正數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人数の倍率には有限の正数を指定してください。"
          }
        }
      }
    },
    "This amount cannot be calculated without losing precision. Keep the original amount or edit it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此用量无法在不损失精度的情况下计算。请保留原始用量或进行编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此用量無法在不損失精度的情況下計算。請保留原始用量或進行編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "精度を保ったままこの量を計算できません。元の量を保持するか編集してください。"
          }
        }
      }
    },
    "Give each ingredient a name, or remove the empty row.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为每种食材填写名称，或移除空白行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請為每種食材填寫名稱，或移除空白列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各材料に名前を入力するか、空の行を削除してください。"
          }
        }
      }
    },
    "%@ must be a whole number between %@ and %@, or left blank.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
