          }
        }
      }
    },
    "A collection with this name already exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名食谱册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在同名食譜集。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のコレクションがすでにあります。"
          }
        }
      }
    },
    "Choose a serving count greater than zero.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择大于零的份数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇大於零的份數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1以上の人数を選択してください。"
          }
        }
      }
    },
    "Set the recipe's original serving count before scaling it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先设置食谱的原始份数，再进行换算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先設定食譜的原始份數，再進行換算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分量を変更する前に、レシピの元の人数を設定してください。"
          }
        }
      }
    },
    "The recipe's serving count must be greater than zero.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱份数必须大于零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜份數必須大於零。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピの人数は1以上にしてください。"
          }
        }
      }
    },
    "Give each selected ingredient a name before adding it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加前请为每种所选食材填写名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增前請為每種所選食材填寫名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加する前に、選択した各材料に名前を付けてください。"
          }
        }
      }
    },
    "Choose a valid date for your meal.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择有效的用餐日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇有效的用餐日期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な食事の日付を選択してください。"
          }
        }
      }
    },
    "The library contains duplicate identifiers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱库中包含重复标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜庫中包含重複識別碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに重複した識別子があります。"
          }
        }
      }
    },
    "The library contains an item that is also marked as deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱库中有项目同时被标记为已删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜庫中有項目同時被標記為已刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ内の項目が削除済みとしても記録されています。"
          }
        }
      }
    },
    "Collection names must be unique and cannot be empty.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱册名称不能为空且必须唯一。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜集名稱不可為空且必須唯一。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクション名は空欄にできず、重複もできません。"
          }
        }
      }
    },
    "A collection contains an unavailable or duplicate recipe relationship.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱册包含不可用或重复的食谱关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜集包含無法使用或重複的食譜關聯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションに利用できない、または重複したレシピとの関連があります。"
          }
        }
      }
    },
    "Check the recipe's servings, times and ingredient identifiers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查食谱份数、时间和食材标识符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查食譜份數、時間和食材識別碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピの人数、時間、材料識別子を確認してください。"
          }
        }
      }
    },
    "Check the cooking step's ingredient links and timers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查烹饪步骤的食材关联和计时器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查烹飪步驟的食材關聯和計時器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調理手順に紐付く材料とタイマーを確認してください。"
          }
        }
      }
    },
    "Check the grocery item's name and recipe sources.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查购物清单项目的名称和关联食谱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查購物清單項目的名稱和關聯食譜。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い物リスト項目の名前とレシピソースを確認してください。"
          }
        }
      }
    },
    "A meal plan refers to an unavailable recipe or date.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "周计划引用了不可用的食谱或日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週計畫引用了無法使用的食譜或日期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Meal Planが利用できないレシピまたは日付を参照しています。"
          }
        }
      }
    },
    "A day contains more than one recipe in the same meal slot.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一天的同一餐次安排了多份食谱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一天的同一餐次安排了多份食譜。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ日の同じ食事枠に複数のレシピが登録されています。"
          }
        }
      }
    },
    "Give the collection a name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为食谱册命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請為食譜集命名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクションに名前を付けてください。"
          }
        }
      }
    },
    "Collection names can be up to 80 characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱册名称最多可包含 80 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜集名稱最多可包含 80 個字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクション名は80文字以内で入力してください。"
          }
        }
      }
    },
    "Favorites is already built in.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“收藏”已是内置食谱册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「收藏」已是內建食譜集。"
