    "Cloud sync changed while this device was saving. Try again.": {
      "comment": "Localized shared/core/service message.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备保存期间云同步状态发生变化，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置儲存期間雲端同步狀態發生變化，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存中にクラウドの同期状態が変わりました。もう一度お試しください。"
          }
        },
        "de": {
