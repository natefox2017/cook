    },
    "This version stores your recipes, recipe images, source information, grocery list, meal plan and preferences on this iPhone. Your local profile is optional and does not create an online account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本会将食谱、食谱图片、来源信息、购物清单、周计划和偏好设置保存在这部 iPhone 上。你可以选择填写本机个人资料，这不会创建在线账号。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本會將食譜、食譜照片、來源資訊、購物清單、週計畫和偏好設定保存在這部 iPhone 上。你可以選擇填寫本機個人資料，這不會建立線上帳號。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは、レシピ、画像、ソース情報、買い物リスト、Meal Plan、設定がこのiPhoneに保存されます。ローカルプロフィールは任意で、オンラインアカウントは作成されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version speichert deine Rezepte, Rezeptbilder, Quellinformationen, Einkaufsliste, den Wochenplan und Einstellungen auf diesem iPhone. Dein lokales Profil ist optional und erstellt kein Online-Konto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version conserve vos recettes, images, sources, liste de courses, planning des repas et préférences sur cet iPhone. Votre profil local est facultatif et ne crée pas de compte en ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión guarda tus recetas, imágenes de recetas, información de fuentes, lista de compras, plan de comidas y preferencias en este iPhone. Tu perfil local es opcional y no crea una cuenta en línea."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione conserva ricette, immagini, informazioni sulle fonti, lista della spesa, piano pasti e preferenze su questo iPhone. Il profilo locale è facoltativo e non crea un account online."
          }
        }
      }
    },
