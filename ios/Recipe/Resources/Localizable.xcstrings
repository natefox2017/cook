        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源已儲存 — 請補充缺少的資訊"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースを保存しました — 不足している詳細を追加してください"
          }
        }
      }
    },
    "Saved to your recipes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到食谱库"
