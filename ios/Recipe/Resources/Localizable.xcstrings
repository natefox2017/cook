    "Tap the heart on a recipe to keep your go-to dishes together.": {
      "comment": "User-facing Recipe iOS copy.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击食谱上的爱心，将常做的菜收藏在一起。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
