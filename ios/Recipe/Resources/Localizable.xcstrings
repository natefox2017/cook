    "Amount, for example 2 cups or to taste": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分量（例：2カップ、適量）"
          }
        },
        "zh-Hans": {
