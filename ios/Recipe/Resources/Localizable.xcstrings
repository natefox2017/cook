      }
    },
    "The original shared source is missing. Share it again.": {
      "comment": "Localized shared/core/service message.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始分享内容已丢失，请重新分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始分享內容已遺失，請重新分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有元のコンテンツが見つかりません。もう一度共有してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche geteilte Quelle fehlt. Teile sie erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source partagée d’origine est manquante. Partagez-la à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
