        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏的食譜都在這裡。"
          }
        }
      }
    },
    "%@ Recipes": {
      "comment": "Recipe library count. Plural forms are chosen by the String Catalog for the current language.",
      "localizations": {
