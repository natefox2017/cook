    "A recipe can belong to more than one collection. Favorites stays separate.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピは複数のコレクションに入れられます。お気に入りは別に管理されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
