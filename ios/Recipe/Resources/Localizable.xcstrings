            "value": "相機權限已關閉。請在 iPhone 設定中為 Recipe 開啟相機權限，或從照片匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスがオフです。iPhoneの設定でRecipeのカメラアクセスを許可するか、写真から取り込んでください。"
          }
        }
      }
    },
    "Source saved — add the missing details": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源已保存 — 请补充缺失信息"
