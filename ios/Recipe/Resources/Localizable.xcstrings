    "Compatible amounts combine safely. Unclear amounts stay as written.": {
      "comment": "User-facing Recipe iOS copy.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容的食材用量会合并，不明确的用量保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相容的食材用量會合併，不明確的用量維持原樣。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "組み合わせ可能な分量は統合し、不明確な分量は元のまま残します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompatible Mengen werden sicher zusammengeführt. Unklare Mengen bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quantités compatibles se regroupent sans risque. Les quantités imprécises restent telles quelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cantidades compatibles se combinan de forma segura. Las cantidades imprecisas se mantienen como están escritas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quantità compatibili vengono unite in modo sicuro. Quelle poco chiare restano invariate."
          }
        }
      }
    },
    "Each selected ingredient becomes a separate item. Existing items are unchanged.": {
      "comment": "User-facing Recipe iOS copy.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种选中的食材单独加入，现有项目不会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每種選取的食材會個別加入，現有項目不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した材料をそれぞれ別項目として追加し、既存の項目は変更しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede ausgewählte Zutat wird zu einem eigenen Eintrag. Vorhandene Einträge bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ingrédient sélectionné devient un article distinct. Les articles existants restent inchangés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ingrediente seleccionado se convierte en un artículo independiente. Los artículos existentes no cambian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ingrediente selezionato diventa un articolo separato. Gli articoli esistenti restano invariati."
          }
        }
      }
    },
