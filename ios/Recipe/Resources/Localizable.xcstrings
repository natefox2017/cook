    "Explore a few sample recipes. You can edit or delete them at any time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルはいつでも編集・削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先看看示例食谱，随时可以编辑或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先看看範例食譜，隨時可以編輯或刪除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entdecke einige Beispielrezepte. Du kannst sie jederzeit bearbeiten oder löschen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez quelques exemples de recettes. Vous pouvez les modifier ou les supprimer à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora algunas recetas de ejemplo. Puedes editarlas o eliminarlas cuando quieras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora alcune ricette di esempio. Puoi modificarle o eliminarle in qualsiasi momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore algumas receitas de exemplo. Você pode editá-las ou excluí-las a qualquer momento."
