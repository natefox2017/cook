    "Numeric amounts adjust with servings. Amounts such as “to taste” stay as written.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明確な数量は人数に合わせて調整されます。「適量」などは元の表記を維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确的数值会随份量调整；“适量”等用量保持原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明確的數值會隨份量調整；「適量」等用量保持原文。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlenmengen passen sich an die Portionenzahl an. Angaben wie „nach Geschmack“ bleiben unverändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quantités numériques s’ajustent au nombre de portions. Les indications comme « selon le goût » restent inchangées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cantidades numéricas se ajustan según las raciones. Expresiones como «al gusto» se mantienen tal como están."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quantità numeriche si adattano alle porzioni. Espressioni come «quanto basta» restano invariate."
          }
        }
      }
    },
