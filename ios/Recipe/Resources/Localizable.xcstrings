    "Recipe Pals’ shared storage is not available. Check App Group signing.": {
      "comment": "Localized shared/core/service message.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私人菜谱无法访问共享存储，请检查 App Group 签名配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私人菜譜無法存取共享儲存空間，請檢查 App Group 簽署設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Pals の共有ストレージにアクセスできません。App Group の署名設定を確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gemeinsame Speicher von Recipe Pals ist nicht verfügbar. Prüfe die App-Group-Signierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage partagé de Recipe Pals est indisponible. Vérifiez la signature App Group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento compartido de Recipe Pals no está disponible. Comprueba la firma de App Group."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’archivio condiviso di Recipe Pals non è disponibile. Controlla la firma dell’App Group."
          }
        }
      }
    },
    "Share a public HTTPS link, readable text, image, or PDF to Recipe Pals.": {
      "comment": "Localized shared/core/service message.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
