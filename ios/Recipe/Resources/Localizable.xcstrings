    "Keep wording such as “to taste” or “a little”. Only explicit numeric amounts are scaled.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「適量」「少々」などの表現は保持し、明確な数量だけ調整します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留“适量”“少许”等原始用量；只调整明确的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留「適量」「少許」等原始用量；只調整明確的數值。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalte Formulierungen wie „nach Geschmack“ oder „etwas“ bei. Nur ausdrücklich angegebene Zahlenmengen werden skaliert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez les indications comme « selon le goût » ou « un peu ». Seules les quantités numériques explicites sont ajustées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva expresiones como «al gusto» o «un poco». Solo se ajustan las cantidades numéricas explícitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni espressioni come «quanto basta» o «un po’». Vengono adattate solo le quantità numeriche esplicite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha expressões como “a gosto” ou “um pouco”. Apenas quantidades numéricas explícitas são ajustadas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoud woorden zoals ‘naar smaak’ of ‘een beetje’. Alleen expliciete numerieke hoeveelheden worden aangepast."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘기호에 맞게’ 또는 ‘조금’ 같은 표현은 그대로 유지됩니다. 명확한 숫자로 된 분량만 조정됩니다."
          }
        }
      }
    },
