    "Include Ingredients and Instructions headings when available. The original text is always kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "可能なら材料と手順の見出しを含めてください。元のテキストは保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有条件时请加入“食材”和“步骤”标题；原始文字始终保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以的話請加上「食材」和「步驟」標題；原始文字會保留。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge, wenn vorhanden, die Überschriften „Zutaten“ und „Zubereitung“ hinzu. Der Originaltext bleibt immer erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluez les titres « Ingrédients » et « Préparation » lorsqu’ils sont disponibles. Le texte d’origine est toujours conservé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye los encabezados de ingredientes e instrucciones cuando estén disponibles. El texto original siempre se conserva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi i titoli Ingredienti e Preparazione, se disponibili. Il testo originale viene sempre conservato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua os títulos Ingredientes e Modo de preparo quando disponíveis. O texto original é sempre mantido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem de kopjes Ingrediënten en Bereiding op als die beschikbaar zijn. De oorspronkelijke tekst blijft altijd bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가능하면 재료와 조리 방법 제목을 포함하세요. 원문은 항상 보관됩니다."
          }
        }
      }
    },
