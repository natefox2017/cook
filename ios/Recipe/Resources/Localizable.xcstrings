        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리가 지원되지 않는 형식으로 저장되었습니다. 원본 파일은 보존되었습니다."
          }
        }
      }
    },
    "Ingredient amounts must be finite numbers of zero or more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食材用量必须是大于或等于零的有限数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食材用量必須是大於或等於零的有限數值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料の量は0以上の有限数で入力してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zutatenmengen müssen endliche Zahlen größer oder gleich null sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les quantités d’ingrédients doivent être des nombres finis supérieurs ou égaux à zéro."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cantidades de los ingredientes deben ser números finitos iguales o mayores que cero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le quantità degli ingredienti devono essere numeri finiti maggiori o uguali a zero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As quantidades dos ingredientes devem ser números finitos iguais ou maiores que zero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrediënthoeveelheden moeten eindige getallen van nul of hoger zijn."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재료 분량은 0 이상의 유한한 숫자여야 합니다."
          }
        }
      }
    },
    "Choose a positive, finite serving multiplier.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "份数倍率必须是有限的正数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "份數倍率必須是有限的正數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人数の倍率には有限の正数を指定してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen positiven, endlichen Portionsfaktor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un multiplicateur de portions positif et fini."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un multiplicador de raciones positivo y finito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un moltiplicatore delle porzioni positivo e finito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um multiplicador de porções positivo e finito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een positieve, eindige vermenigvuldigingsfactor voor de porties."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0보다 큰 유한한 인분 배수를 선택하세요."
          }
        }
      }
    },
    "This amount cannot be calculated without losing precision. Keep the original amount or edit it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此用量无法在不损失精度的情况下计算。请保留原始用量或进行编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此用量無法在不損失精度的情況下計算。請保留原始用量或進行編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "精度を保ったままこの量を計算できません。元の量を保持するか編集してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Menge lässt sich nicht berechnen, ohne an Genauigkeit zu verlieren. Behalte die Originalmenge bei oder bearbeite sie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette quantité ne peut pas être calculée sans perte de précision. Conservez la quantité d’origine ou modifiez-la."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cantidad no se puede calcular sin perder precisión. Conserva la cantidad original o edítala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa quantità non può essere calcolata senza perdere precisione. Mantieni la quantità originale o modificala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível calcular esta quantidade sem perder precisão. Mantenha a quantidade original ou edite-a."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze hoeveelheid kan niet zonder precisieverlies worden berekend. Behoud de oorspronkelijke hoeveelheid of bewerk deze."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정밀도를 잃지 않고 이 분량을 계산할 수 없습니다. 원래 분량을 유지하거나 편집하세요."
          }
        }
      }
    },
    "Give each ingredient a name, or remove the empty row.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为每种食材填写名称，或移除空白行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請為每種食材填寫名稱，或移除空白列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各材料に名前を入力するか、空の行を削除してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib jeder Zutat einen Namen oder entferne die leere Zeile."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nommez chaque ingrédient ou supprimez la ligne vide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon un nombre a cada ingrediente o elimina la fila vacía."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna un nome a ogni ingrediente oppure rimuovi la riga vuota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê um nome a cada ingrediente ou remova a linha vazia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef elk ingrediënt een naam of verwijder de lege rij."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 재료에 이름을 입력하거나 빈 행을 삭제하세요."
          }
        }
      }
    },
    "%@ must be a whole number between %@ and %@, or left blank.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 必须填写 %@ 到 %@ 之间的整数，也可以留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " %@ 必須填寫 %@ 到 %@ 之間的整數，也可以留白。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@には%@から%@までの整数を入力するか、空欄にしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss eine ganze Zahl zwischen %@ und %@ sein oder leer bleiben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit être un nombre entier compris entre %@ et %@, ou rester vide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ debe ser un número entero entre %@ y %@, o dejarse en blanco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve essere un numero intero tra %@ e %@ oppure restare vuoto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve ser um número inteiro entre %@ e %@, ou ficar em branco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ moet een geheel getal tussen %@ en %@ zijn of leeg worden gelaten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) %@부터 %@ 사이의 정수이거나 비워 두어야 합니다."
          }
        }
      }
    },
