    "Bought items will be removed from this list. Your saved recipes will stay in your library.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入済みの項目を一覧から削除します。保存したレシピは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已购买的项目将从清单移除，已保存的食谱不会删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已購買的項目將從清單移除，已儲存的食譜不會刪除。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekaufte Artikel werden aus dieser Liste entfernt. Deine gespeicherten Rezepte bleiben in deiner Bibliothek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les articles achetés seront retirés de cette liste. Vos recettes enregistrées resteront dans votre bibliothèque."
