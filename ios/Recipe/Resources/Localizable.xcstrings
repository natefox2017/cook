    "This removes the item from your grocery list.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目を買い物リストから削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从购物清单中移除该项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從購物清單中移除該項目。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Eintrag aus deiner Einkaufsliste entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire l’article de votre liste de courses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el artículo de tu lista de compras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’articolo verrà rimosso dalla lista della spesa."
          }
        }
      }
    },
    "This removes the recipe from your library and meal plan.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレシピをライブラリと献立から削除します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从食谱库和周计划中移除此食谱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從食譜庫和週計劃中移除此食譜。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Rezept wird aus deiner Bibliothek und deinem Wochenplan entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela retire la recette de votre bibliothèque et du planning des repas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la receta de tu biblioteca y del plan de comidas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricetta verrà rimossa dalla tua raccolta e dal piano pasti."
          }
        }
      }
    },
    "This replaces the unreadable cooking progress for this recipe. The recipe itself is kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込めない調理進捗を置き換えます。レシピ自体は残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会替换无法读取的烹饪进度，食谱本身会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會取代無法讀取的烹飪進度，食譜本身會保留。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der nicht lesbare Kochfortschritt für dieses Rezept ersetzt. Das Rezept selbst bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace la progression de cuisine illisible pour cette recette. La recette elle-même est conservée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto sustituye el progreso de cocina ilegible de esta receta. La receta se conserva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progressi di preparazione illeggibili di questa ricetta verranno sostituiti. La ricetta sarà conservata."
          }
        }
      }
    },
