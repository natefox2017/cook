          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonte originale condivisa è mancante. Condividila di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte original compartilhada não foi encontrada. Compartilhe-a novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De oorspronkelijke gedeelde bron ontbreekt. Deel deze opnieuw."
          }
