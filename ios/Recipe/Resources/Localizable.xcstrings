    "Your signed-in account changed. The saved source was kept for the correct account.": {
      "extractionState": "new",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン中のアカウントが変更されました。保存済みのソースは元のアカウント用に保持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录账号已更改。已为原账号保留保存的来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入帳號已變更。已為原帳號保留儲存的來源。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein angemeldetes Konto wurde geändert. Die gespeicherte Quelle wurde dem richtigen Konto zugeordnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte connecté a changé. La source enregistrée a été conservée pour le bon compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta con la que has iniciado sesión ha cambiado. La fuente guardada se ha conservado para la cuenta correcta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account con cui hai effettuato l’accesso è cambiato. La fonte salvata è stata conservata per l’account corretto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta conectada mudou. A fonte salva foi mantida para a conta correta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent aangemeld met een ander account. De opgeslagen bron is voor het juiste account bewaard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인한 계정이 변경되었습니다. 저장한 출처는 올바른 계정에 보관되었습니다."
          }
        }
      }
    },
    "The shared source is unavailable. It may have expired.": {
      "extractionState": "new",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有したソースを利用できません。期限切れの可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问分享的来源，可能已过期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法存取分享的來源，可能已過期。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geteilte Quelle ist nicht verfügbar. Möglicherweise ist sie abgelaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source partagée est indisponible. Elle a peut-être expiré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente compartida no está disponible. Puede haber caducado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonte condivisa non è disponibile. Potrebbe essere scaduta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte compartilhada está indisponível. Ela pode ter expirado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gedeelde bron is niet beschikbaar. Deze kan zijn verlopen."
          }
        },
