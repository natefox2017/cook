    "Exported %@. Recipe text only; photos, attachments, shopping lists, meal plans and app preferences are not included.": {
      "comment": "Visible label or status in standalone HTML exports.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出时间：%@。仅包含食谱文字，不包括照片、附件、购物清单、膳食计划或应用设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出時間：%@。僅包含食譜文字，不包括相片、附件、購物清單、餐食計畫或 App 設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポート日時：%@。レシピのテキストのみを含み、写真、添付ファイル、買い物リスト、献立、アプリ設定は含まれません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiert: %@. Nur Rezepttext; Fotos, Anhänge, Einkaufslisten, Wochenpläne und App-Einstellungen sind nicht enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exporté. Texte de la recette uniquement ; les photos, pièces jointes, listes de courses, plannings des repas et préférences de l’application ne sont pas inclus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha exportado %@. Solo incluye el texto de las recetas; no incluye fotos, archivos adjuntos, listas de compras, planes de comidas ni preferencias de la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esportato. Solo testo delle ricette; foto, allegati, liste della spesa, piani pasti e preferenze dell’app non sono inclusi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportado %@. Somente o texto das receitas; fotos, anexos, listas de compras, planejamentos de refeições e preferências do app não estão incluídos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
