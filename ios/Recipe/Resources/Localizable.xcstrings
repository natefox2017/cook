    "Amounts can be numbers, ranges or words such as “to taste”. Keep the amount that works for your shop.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用量可填写数字、范围或“适量”等文字，请保留实际需要购买的用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用量可以是數字、範圍或「適量」等文字，請保留實際需要購買的用量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分量は数値・範囲・「適量」などで入力できます。買い物に必要な表記を残してください。"
          }
        }
      }
    },
