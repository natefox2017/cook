        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案過大。請選擇較小的照片，或小於 10 MB 的食譜文件。"
          }
        }
      }
    },
    "This recipe contains more than 100,000 characters. Choose a shorter document or paste a shorter section. Nothing was imported.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレシピは100,000文字を超えています。短い書類を選ぶか、短い範囲を貼り付けてください。今回は何も取り込まれていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此食谱超过 100,000 个字符。请选择较短的文档或粘贴较短的内容。本次未导入任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此食譜超過 100,000 個字元。請選擇較短的文件或貼上較短的內容。本次未匯入任何內容。"
          }
        }
      }
    },
    "Recipe couldn't read this image. Try another photo with the recipe clearly in view.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
