    "Tap the heart on a recipe to keep your go-to dishes here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピのハートを押すとお気に入りに保存されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击食谱上的爱心，收藏常做的菜。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選食譜上的愛心，收藏常做的料理。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe beim Rezept auf das Herz, um deine Lieblingsgerichte hier zu sammeln."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cœur d’une recette pour retrouver vos plats préférés ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón de una receta para guardar aquí tus platos habituales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il cuore su una ricetta per conservare qui i tuoi piatti preferiti."
          }
        }
      }
    },
