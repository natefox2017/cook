          }
        }
      }
    },
    "The recipe's serving count must be greater than zero.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱份数必须大于零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食譜份數必須大於零。"
          }
