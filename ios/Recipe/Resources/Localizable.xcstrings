    "Your signed-in account changed. The saved source was kept for the correct account.": {
      "extractionState": "new",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン中のアカウントが変更されました。保存済みのソースは元のアカウント用に保持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录账号已更改。已为原账号保留保存的来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入帳號已變更。已為原帳號保留儲存的來源。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein angemeldetes Konto wurde geändert. Die gespeicherte Quelle wurde dem richtigen Konto zugeordnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte connecté a changé. La source enregistrée a été conservée pour le bon compte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuenta con la que has iniciado sesión ha cambiado. La fuente guardada se ha conservado para la cuenta correcta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’account con cui hai effettuato l’accesso è cambiato. La fonte salvata è stata conservata per l’account corretto."
          }
        }
      }
    },
    "The shared source is unavailable. It may have expired.": {
