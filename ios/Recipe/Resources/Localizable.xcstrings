    "The saved session could not be read. Its original data has been kept. Start a new session to cook this recipe again.": {
      "comment": "User-facing Recipe iOS copy.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取上次的烹饪进度，原始数据已保留。请开始新的烹饪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取上次的烹飪進度，原始資料已保留。請開始新的烹飪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の調理状況を読み込めませんでした。元のデータは保持されています。新しいセッションを開始してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Sitzung konnte nicht gelesen werden. Die Originaldaten wurden beibehalten. Starte eine neue Sitzung, um dieses Rezept erneut zu kochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session enregistrée n’a pas pu être lue. Ses données d’origine ont été conservées. Démarrez une nouvelle session pour cuisiner à nouveau cette recette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la sesión guardada. Sus datos originales se han conservado. Inicia una sesión nueva para volver a cocinar esta receta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere la sessione salvata. I dati originali sono stati conservati. Avvia una nuova sessione per cucinare di nuovo questa ricetta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a sessão salva. Os dados originais foram mantidos. Inicie uma nova sessão para cozinhar esta receita novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgeslagen sessie kon niet worden gelezen. De oorspronkelijke gegevens zijn bewaard. Start een nieuwe sessie om dit recept opnieuw te koken."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 세션을 읽지 못했습니다. 원본 데이터는 보존되었습니다. 이 레시피를 다시 요리하려면 새 세션을 시작하세요."
          }
        }
      }
    },
