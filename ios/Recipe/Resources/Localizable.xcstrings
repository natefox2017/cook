    "Keep wording such as “to taste” or “a little”. Only explicit numeric amounts are scaled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留“适量”“少许”等原始用量；只调整明确的数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留「適量」「少許」等原始用量；只調整明確的數值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「適量」「少々」などの表現は保持し、明確な数量だけ調整します。"
          }
        }
      }
    },
