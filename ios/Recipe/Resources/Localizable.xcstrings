    "Tip: private pages and social videos may not expose complete recipe text. Keep the source link and add text or screenshots when needed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：私人页面和社交视频可能无法提供完整食谱文本。请保留来源链接，并在需要时补充文本或截图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：私人頁面和社群影片可能無法提供完整食譜文字。請保留來源連結，並在需要時補充文字或截圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非公開ページやSNS動画ではレシピの全テキストを取得できない場合があります。ソースリンクを残し、必要に応じてテキストやスクリーンショットを追加してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinweis: Private Seiten und Social-Media-Videos stellen möglicherweise nicht den vollständigen Rezepttext bereit. Bewahre den Quelllink auf und füge bei Bedarf Text oder Screenshots hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseil : les pages privées et les vidéos des réseaux sociaux peuvent ne pas donner accès au texte complet de la recette. Conservez le lien source et ajoutez du texte ou des captures d’écran si nécessaire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: las páginas privadas y los vídeos de redes sociales pueden no mostrar el texto completo de la receta. Conserva el enlace a la fuente y añade texto o capturas de pantalla si hace falta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: le pagine private e i video social potrebbero non rendere disponibile il testo completo della ricetta. Conserva il link alla fonte e aggiungi testo o schermate quando necessario."
          }
        }
      }
    },
    "You completed %@ of %@ steps for %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You completed %1$@ of %2$@ steps for %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已完成 %@ / %@ 个步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已完成 %@ / %@ 個步驟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の手順 %@ / %@ が完了しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %@ von %@ Schritten für %@ abgeschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez terminé %@ étapes sur %@ pour %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has completado %@ de %@ pasos de %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai completato %@ di %@ passaggi per %@."
          }
        }
      }
    },
    "Your Recipe Pals account identifies future private cloud data. It is separate from the Apple ID that owns an App Store subscription.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私人菜谱账号用于标识今后的私有云端数据，与拥有 App Store 订阅的 Apple ID 相互独立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私人菜譜帳號用來識別未來的私有雲端資料，與擁有 App Store 訂閱的 Apple ID 彼此獨立。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Palsアカウントは今後のプライベートなクラウドデータを識別します。App Storeのサブスクリプションを所有するApple IDとは別です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Recipe-Pals-Konto kennzeichnet künftige private Cloud-Daten. Es ist getrennt von der Apple-ID, der das App-Store-Abo gehört."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte Recipe Pals identifie les futures données cloud privées. Il est distinct de l’identifiant Apple auquel appartient un abonnement App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta de Recipe Pals identifica futuros datos privados en la nube. Es independiente del Apple ID al que pertenece una suscripción del App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account Recipe Pals identifica i futuri dati cloud privati. È separato dall’ID Apple a cui appartiene l’abbonamento App Store."
          }
        }
      }
    },
