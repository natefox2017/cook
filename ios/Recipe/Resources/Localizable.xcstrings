          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar o status da assinatura da App Store. Tente novamente quando estiver on-line."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
