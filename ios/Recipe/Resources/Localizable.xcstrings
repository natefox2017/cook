          }
        }
      }
    },
    "The App Store verified your purchase, but the entitlement is not yet available. Check your subscription status or try Restore Purchases.": {
      "comment": "Localized shared/core/service message.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 已验证购买，但订阅权益尚未生效。请检查订阅状态或尝试恢复购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 已驗證購買，但訂閱權益尚未生效。請檢查訂閱狀態或嘗試恢復購買。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store で購入は確認されましたが、利用権限がまだ反映されていません。契約状況を確認するか、購入を復元してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store hat deinen Kauf verifiziert, aber dein Anspruch ist noch nicht verfügbar. Prüfe deinen Abonnementstatus oder versuche, Käufe wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store a vérifié votre achat, mais les droits ne sont pas encore disponibles. Vérifiez l’état de votre abonnement ou essayez « Restaurer les achats »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store ha verificado tu compra, pero el acceso aún no está disponible. Comprueba el estado de tu suscripción o prueba Restaurar compras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store ha verificato il tuo acquisto, ma il diritto di accesso non è ancora disponibile. Controlla lo stato dell’abbonamento o prova Ripristina acquisti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store verificou sua compra, mas o acesso ainda não está disponível. Verifique o status da assinatura ou tente Restaurar compras."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store heeft je aankoop geverifieerd, maar de bijbehorende toegang is nog niet beschikbaar. Controleer je abonnementsstatus of probeer Aankopen herstellen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 구매를 검증했지만 이용 권한은 아직 제공되지 않습니다. 구독 상태를 확인하거나 구매 복원을 시도하세요."
          }
        }
      }
    },
    "The App Store subscription status could not be checked. Try again when you are online.": {
      "comment": "Localized shared/core/service message.",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法检查 App Store 订阅状态，请联网后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法檢查 App Store 訂閱狀態，請連線後重試。"
          }
        },
        "ja": {
