    "Numeric amounts adjust with servings. Amounts such as “to taste” stay as written.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明确的数值会随份量调整；“适量”等用量保持原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明確的數值會隨份量調整；「適量」等用量保持原文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明確な数量は人数に合わせて調整されます。「適量」などは元の表記を維持します。"
          }
        }
      }
    },
