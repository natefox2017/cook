    "Tell AI what you’re craving or what ingredients you have. Get an idea ready to cook.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食べたいものや手元の食材をAIに伝えて、料理のアイデアを作りましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉 AI 你想吃什么或手头有哪些食材，生成一道菜谱灵感。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴 AI 你想吃什麼或手邊有哪些食材，生成一道食譜靈感。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag der KI, worauf du Appetit hast oder welche Zutaten du hast. Lass dir eine Idee erstellen, mit der du direkt kochen kannst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites à l’IA ce qui vous fait envie ou quels ingrédients vous avez. Obtenez une idée prête à cuisiner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a la IA qué te apetece o qué ingredientes tienes. Obtén una idea lista para cocinar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dì all’IA cosa ti va di mangiare o quali ingredienti hai. Ottieni un’idea pronta da cucinare."
          }
        }
      }
    },
