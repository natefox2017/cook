        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le cœur d’une recette pour rassembler vos plats préférés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el corazón de una receta para reunir tus platos habituales."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il cuore su una ricetta per tenere insieme i tuoi piatti preferiti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no coração de uma receita para reunir seus pratos preferidos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het hartje bij een recept om je vaste favorieten bij elkaar te bewaren."
