      }
    },
    "Your running timers will stop when you finish this recipe.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調理を終了すると実行中のタイマーは停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束烹饪后，正在运行的计时器将停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束烹飪後，執行中的計時器將停止。"
          }
        }
      }
    },
    "Your saved recipes, all in one place.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したレシピをここでまとめて管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏的食谱都在这里。"
          }
