    "Country is a preference for future regional content. It does not change your account country or App Store subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地区选择用于未来的本地化内容，不会更改账户地区或 App Store 订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "地區選擇用於未來的在地化內容，不會變更帳戶地區或 App Store 訂閱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この地域設定は将来のコンテンツ向けです。アカウントの国やApp Storeのサブスクリプションは変わりません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Land legt regionale Inhalte für die Zukunft fest. Es ändert weder dein Kontoland noch deine App-Store-Abos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pays est une préférence pour les futurs contenus régionaux. Il ne modifie pas le pays de votre compte ni vos abonnements App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El país es una preferencia para contenido regional futuro. No cambia el país de tu cuenta ni las suscripciones del App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il paese è una preferenza per futuri contenuti regionali. Non cambia il paese dell’account né gli abbonamenti App Store."
          }
        }
      }
    },
