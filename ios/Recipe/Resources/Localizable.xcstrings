    "A recipe can belong to more than one collection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピは複数のコレクションに追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一食谱可以加入多个食谱册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一食譜可以加入多個食譜集。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Rezept kann zu mehreren Sammlungen gehören."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recette peut appartenir à plusieurs collections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una receta puede pertenecer a más de una colección."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ricetta può appartenere a più raccolte."
          }
        }
      }
    },
    "A recipe can belong to more than one collection. Favorites stays separate.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レシピは複数のコレクションに入れられます。お気に入りは別に管理されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份食谱可属于多个食谱册；喜欢的食谱单独管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
