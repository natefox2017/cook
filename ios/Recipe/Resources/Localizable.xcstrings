    "Missing ingredients or steps? Save a draft and finish it later.": {
      "extractionState": "stale",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "材料や手順が不足していても下書き保存できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食材或步骤不完整？可以先保存草稿，稍后补充。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "食材或步驟不完整？可以先儲存草稿，稍後補充。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlen Zutaten oder Schritte? Speichere einen Entwurf und ergänze sie später."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des ingrédients ou des étapes manquent ? Enregistrez un brouillon et complétez-le plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Faltan ingredientes o pasos? Guarda un borrador y complétalo más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mancano ingredienti o passaggi? Salva una bozza e completala più tardi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam ingredientes ou etapas? Salve um rascunho e termine depois."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontbreken er ingrediënten of stappen? Sla een concept op en maak het later af."
