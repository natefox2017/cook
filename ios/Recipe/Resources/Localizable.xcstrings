    "Tell AI what you’re craving or what ingredients you have. Get an idea ready to cook.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食べたいものや手元の食材をAIに伝えて、料理のアイデアを作りましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
