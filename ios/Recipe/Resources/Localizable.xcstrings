        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一天的同一餐次安排了多份食譜。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ日の同じ食事枠に複数のレシピが登録されています。"
          }
        }
      }
    },
    "Give the collection a name.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请为食谱册命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請為食譜集命名。"
