            "state": "translated",
            "value": "コレクションに名前を付けてください。"
          }
        }
      }
    },
    "Collection names can be up to 80 characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱册名称最多可包含 80 个字符。"
          }
        },
