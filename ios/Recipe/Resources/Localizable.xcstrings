    "Choose from your saved recipes. Open a planned recipe when you’re ready to cook or add its ingredients to Groceries.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从保存的食谱中选择，准备做饭时打开食谱，或将食材加入购物清单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從儲存的食譜中選擇，準備料理時開啟食譜，或將食材加入購物清單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したレシピから選びましょう。調理するときはレシピを開くか、材料を買い物リストに追加できます。"
