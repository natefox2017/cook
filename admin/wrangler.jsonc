{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recipe-admin",
  "account_id": "5eb48a9a09afb3e8b98952ab80de0888",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ADMIN_FUNCTIONS_URL": "https://semsjyrqjnumpvanibip.supabase.co/functions/v1"
  },
  "routes": [
    { "pattern": "admin.shopkivoo.com", "custom_domain": true }
  ]
}
